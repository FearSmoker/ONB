NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# for Elastic Cloud: create an API key in Kibana > Stack Management > API Keys
ELASTICSEARCH_API_KEY=
SESSION_SECRET=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ReachInbox Scheduler
ETHEREAL_AUTO_CREATE=true

EMAIL_QUEUE_NAME=email-send
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ── Cloudinary (OPTIONAL — for file attachments) ──────────────────────────────
# Leave blank to use local disk fallback: files saved to apps/backend/uploads/
# and served at http://localhost:4000/uploads/<filename>
# Get free credentials at https://cloudinary.com (free tier: 25GB storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
